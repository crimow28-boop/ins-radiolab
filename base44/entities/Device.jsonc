{
  "name": "Device",
  "type": "object",
  "properties": {
    "serial_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e1\u05d9\u05d3\u05d5\u05e8\u05d9 (\u05e6')"
    },
    "device_group": {
      "type": "string",
      "enum": [
        "713",
        "710",
        "711",
        "hargol",
        "elal",
        "lotus"
      ],
      "description": "\u05e7\u05d1\u05d5\u05e6\u05ea \u05de\u05db\u05e9\u05d9\u05e8"
    },
    "device_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05db\u05e9\u05d9\u05e8"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "maintenance",
        "replaced"
      ],
      "default": "active"
    },
    "encryption_status": {
      "type": "string",
      "enum": [
        "encrypted",
        "not_encrypted"
      ],
      "default": "not_encrypted"
    },
    "ip_address": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea IP (\u05dc\u05d7\u05e8\u05d2\u05d5\u05dc)"
    },
    "last_inspection_date": {
      "type": "string",
      "format": "date"
    },
    "total_inspections": {
      "type": "number",
      "default": 0
    },
    "total_faults": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "serial_number",
    "device_group"
  ]
}