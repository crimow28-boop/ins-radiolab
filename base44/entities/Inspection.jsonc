{
  "name": "Inspection",
  "type": "object",
  "properties": {
    "inspection_number": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d1\u05d3\u05d9\u05e7\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed"
      ],
      "default": "completed",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05d4\u05ea\u05e7\u05d3\u05de\u05d5\u05ea"
    },
    "checklist_answers": {
      "type": "string",
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05dc\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4 (JSON)"
    },
    "device_serial_numbers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05e1\u05e4\u05e8\u05d9\u05dd \u05e1\u05d9\u05d3\u05d5\u05e8\u05d9 \u05e9\u05dc \u05de\u05db\u05e9\u05d9\u05e8\u05d9\u05dd \u05e0\u05d1\u05d3\u05e7\u05d9\u05dd"
    },
    "soldier_name": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "card_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05db\u05e8\u05d8\u05d9\u05e1 (\u05e9\u05d2\u05e8\u05d4/\u05de\u05d9\u05d5\u05d7\u05d3) \u05e9\u05de\u05de\u05e0\u05d5 \u05d1\u05d5\u05e6\u05e2\u05d4 \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4"
    },
    "card_title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05db\u05e8\u05d8\u05d9\u05e1"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "routine",
        "special"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05db\u05e8\u05d8\u05d9\u05e1"
    },
    "antenna_type": {
      "type": "string"
    },
    "system_type": {
      "type": "string"
    },
    "sealing_status": {
      "type": "boolean"
    },
    "sealing_screws_closed": {
      "type": "boolean"
    },
    "cavad_status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "cavad_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "test_number": {
            "type": "number"
          },
          "lower_limit": {
            "type": "string"
          },
          "upper_limit": {
            "type": "string"
          },
          "measured_value": {
            "type": "string"
          }
        }
      }
    },
    "encryption_check": {
      "type": "boolean"
    },
    "frequencies_check": {
      "type": "boolean"
    },
    "side_connector_closed": {
      "type": "boolean"
    },
    "communication_test": {
      "type": "boolean"
    },
    "battery_replaced": {
      "type": "boolean"
    },
    "fault_description": {
      "type": "string"
    },
    "device_replaced": {
      "type": "boolean"
    },
    "replaced_device_serial": {
      "type": "string"
    },
    "additional_equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remarks": {
      "type": "string"
    },
    "soldier_signature": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "personal_number": {
          "type": "string"
        },
        "signature_data": {
          "type": "string"
        }
      }
    },
    "supervisor_signature": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "personal_number": {
          "type": "string"
        },
        "signature_data": {
          "type": "string"
        },
        "approval_code": {
          "type": "string"
        }
      }
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "delivered",
        "not_delivered"
      ]
    },
    "delivery_soldier_name": {
      "type": "string"
    },
    "delivery_signature": {
      "type": "string"
    },
    "inspection_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "device_serial_numbers",
    "soldier_name",
    "profile"
  ]
}