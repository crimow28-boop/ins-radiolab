{
  "name": "InspectionChecklist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e8\u05e9\u05d9\u05de\u05d4 (\u05dc\u05de\u05e9\u05dc: 710 \u05dc\u05dc\u05d0 \u05de\u05d2\u05d1\u05e8)"
    },
    "code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05de\u05d6\u05d4\u05d4 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 (\u05dc\u05de\u05e9\u05dc: 710_no_amp)",
      "enum": [
        "710_no_amp",
        "710_amp",
        "711_no_amp",
        "711_amp",
        "713_no_amp",
        "713_amp",
        "hargol",
        "elal",
        "lotus"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4"
          },
          "type": {
            "type": "string",
            "enum": [
              "checkbox",
              "text",
              "select"
            ],
            "default": "checkbox",
            "description": "\u05e1\u05d5\u05d2 \u05d4\u05e9\u05d3\u05d4 (\u05ea\u05d9\u05d1\u05ea \u05e1\u05d9\u05de\u05d5\u05df, \u05d8\u05e7\u05e1\u05d8, \u05d1\u05d7\u05d9\u05e8\u05d4)"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "\u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05d1\u05d7\u05d9\u05e8\u05d4 (\u05e2\u05d1\u05d5\u05e8 \u05e9\u05d3\u05d4 \u05de\u05e1\u05d5\u05d2 \u05d1\u05d7\u05d9\u05e8\u05d4)"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "subItems": {
            "type": "array",
            "description": "\u05e1\u05e2\u05d9\u05e4\u05d9\u05dd \u05e9\u05d9\u05d5\u05e4\u05d9\u05e2\u05d5 \u05d0\u05dd \u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d4\u05d9\u05d0 '\u05dc\u05d0' (\u05e2\u05d1\u05d5\u05e8 checkbox)",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "name",
    "code",
    "items"
  ]
}